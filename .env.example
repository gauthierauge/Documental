# Modèle versionné, sans secret : `make env` en tire le .env de développement. En production,
# ces variables vivent chez l'hébergeur (`make env-check` vérifie un fichier avant le déploiement).
PORT=8787

# Protection du serveur HTTP. Les valeurs ci-dessous sont celles par défaut.
# Taille maximale du corps d'une requête de l'API, en Ko (413 au-delà).
BODY_MAX_KB=100
# Requêtes de l'API par adresse IP et par fenêtre glissante (429 au-delà, /api/health exclu).
# Compteurs en mémoire : chaque instance du serveur compte de son côté.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_S=60
# Qui donne l'adresse IP réelle du visiteur : aucun (la connexion elle-même), cloudflare
# (CF-Connecting-IP) ou x-forwarded-for (proxy, répartiteur). Derrière un proxy avec « aucun »,
# tous les visiteurs ont l'adresse du proxy et partagent la même limite.
TRUST_PROXY=aucun
# Avec x-forwarded-for : nombre de proxys de confiance devant le serveur.
TRUST_PROXY_HOPS=1
# Durée maximale de traitement d'une requête de l'API, en millisecondes (503 au-delà).
REQUEST_TIMEOUT_MS=15000
# Taille maximale d'un fichier joint à un document, en Mo (413 au-delà).
UPLOAD_MAX_MB=30
# Arrêt (SIGTERM, docker stop) : attente maximale des requêtes en cours, en millisecondes.
SHUTDOWN_TIMEOUT_MS=7000
# Contact de /.well-known/security.txt : e-mail ou page https. Vide : fichier non servi.
SECURITY_CONTACT=
# PostgreSQL. Vide en développement : PGlite (PostgreSQL dans un dossier local, rien à installer).
DATABASE_URL=
# E-mails : console (développement), brevo ou resend. La clé vit chez l'hébergeur.
MAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM=Ne pas répondre <noreply@exemple.fr>
# Connexion. APP_URL : l'adresse du site vue par le navigateur (liens envoyés par e-mail).
APP_URL=http://localhost:5173
# Au moins 32 caractères aléatoires en production : openssl rand -base64 32
AUTH_SECRET=
# true : refuse les mots de passe présents dans les fuites connues (Have I Been Pwned, k-anonymat). Voir docs/connexion.md.
PASSWORD_HIBP=false
# Docker (compose.yaml) : mot de passe de la base PostgreSQL locale des conteneurs.
POSTGRES_PASSWORD=
