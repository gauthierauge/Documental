{
  "name": "@documental/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "NODE_ENV=production bun src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts",
    "admin:creer": "bun --env-file=../../.env src/auth/create-admin.ts",
    "test": "vitest run --config ../../vite.config.ts --project api"
  },
  "dependencies": {
    "@documental/contracts": "workspace:*",
    "@electric-sql/pglite": "0.5.8",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  }
}
