{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../node_modules/.cache/tsc/apps-web",
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/apps-web.tsbuildinfo",
    "types": ["bun", "vitest/globals", "@testing-library/jest-dom", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@documental/contracts/*": ["./../../packages/contracts/src/*"],
      "@documental/ui/*": ["./../../packages/ui/src/*"]
    }
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/ui"
    }
  ]
}
